@prefix m: <https://github.com/TalbyAI/talby-domain/vocab/mocking#> .
@prefix d: <urn:talby:prototype:declaration:> .
@prefix s: <urn:talby:prototype:scenario:> .

s:ApproveKnownProject a m:Scenario ;
    m:operation d:ApproveProject ;
    m:when 'proyectoId == "prj_001"' ;
    m:responseJson '{"proyectoId":"prj_001","aprobado":true}' .
