@prefix c: <https://example.org/talby/contract#> .
@prefix d: <urn:talby:prototype:declaration:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

d:Service a c:Module ; c:name "GestionProyectos" .
d:ProjectsFeature a c:Feature ; c:name "Proyectos" ; c:parent d:Service .
d:Client c:parent d:Service .
d:Project c:parent d:ProjectsFeature .
d:ApproveProject c:parent d:ProjectsFeature ; c:errors d:CannotApprove .
d:CannotApprove a c:BusinessError ; c:module d:Service ;
    c:code "PROYECTO_NO_APROBABLE" ; c:detailsType d:RejectionDetails .
d:RejectionDetails a c:FieldGroup ; c:name "DetalleRechazo" ; c:uses d:ProjectIdUse .

d:Title rdfs:label "Título"@es ; rdfs:comment "Nombre público del cliente o proyecto."@es .

# Tipos de ejemplo: la restricción heredada no se elimina al añadir otra.
d:ShortText a c:ValueType ; c:baseType c:Text ; c:constraint d:Title100 .
d:CompactText a c:ValueType ; c:baseType d:ShortText ; c:constraint d:Title60 .
d:Status a c:ValueType ; c:baseType c:Text ; c:constraint d:StatusValues .
d:StatusValues a c:OneOf ; c:allowedValue "borrador", "aprobado" .

# IRIs de muestra fijas: no se regeneran al cambiar c:name o la agrupación.
d:Title a c:Field ; c:name "titulo" ; c:valueType c:Text ;
    c:normalizers (c:Trim) ; c:constraint d:Title100 .
d:Title100 a c:MaxLength ; c:limit 100 .
d:Title60 a c:MaxLength ; c:limit 60 .
d:TitleUse a c:FieldUse ; c:field d:Title .
d:ShortTitleUse a c:FieldUse ; c:field d:Title ;
    c:name "tituloCorto" ; c:constraint d:Title60 .

# Un mismo FieldUse nombrado se comparte entre dos agrupaciones.
d:Client a c:Entity ; c:name "Cliente" ; c:uses d:TitleUse, d:ClientIdUse ;
    c:identifierUse d:ClientIdUse .
d:ClientId a c:Field ; c:name "clienteId" ; c:valueType c:Identifier .
d:ClientIdUse a c:FieldUse ; c:field d:ClientId .
d:Project a c:Entity ; c:name "Proyecto" ;
    c:uses d:TitleUse, d:ShortTitleUse, d:PlannedPeriod, d:ActualPeriod,
        d:ClientUse, d:TagsUse, _:amount, d:ProjectIdUse ;
    c:identifierUse d:ProjectIdUse .
d:ProjectIdUse a c:FieldUse ; c:field d:ProjectId .

d:Start a c:Field ; c:name "inicio" ; c:valueType c:Date .
d:End a c:Field ; c:name "fin" ; c:valueType c:Date .
d:Period a c:FieldGroup ; c:name "Periodo" ;
    c:uses [ a c:FieldUse ; c:field d:Start ],
           [ a c:FieldUse ; c:field d:End ] ;
    c:constraint d:PeriodOrder .
d:PeriodOrder a c:Assertion ;
    c:expression "compareDate(fin, inicio) >= 0" .
d:PeriodField a c:Field ; c:name "periodo" ; c:valueType d:Period .
d:PlannedPeriod a c:FieldUse ; c:field d:PeriodField ; c:name "periodoPrevisto" .
d:ActualPeriod a c:FieldUse ; c:field d:PeriodField ; c:name "periodoReal" .

d:ClientReference a c:EntityReference ; c:targetEntity d:Client .
d:ClientField a c:Field ; c:name "cliente" ; c:valueType d:ClientReference .
d:ClientUse a c:FieldUse ; c:field d:ClientField .
d:Tags a c:CollectionType ; c:itemType c:Text .
d:TagsField a c:Field ; c:name "etiquetas" ; c:valueType d:Tags .
d:TagsUse a c:FieldUse ; c:field d:TagsField .
d:Amount a c:Field ; c:name "importe" ; c:valueType c:Decimal .
_:amount a c:FieldUse ; c:field d:Amount .

# Un blank node tampoco queda restringido a una sola agrupación.
d:ProjectSummary a c:ReadModel ; c:name "ResumenProyecto" ; c:uses _:amount .
d:ProjectId a c:Field ; c:name "proyectoId" ; c:valueType c:Identifier .
d:ApproveProject a c:Command ; c:name "AprobarProyecto" ;
    c:uses [ a c:FieldUse ; c:field d:ProjectId ] ; c:result d:ApprovalResult ;
    c:requiresPermission d:ApprovePermission .
d:ApprovePermission a c:Permission ; c:name "aprobarProyecto" .
d:Approved a c:Field ; c:name "aprobado" ; c:valueType c:Boolean .
d:ApprovalResult a c:ReadModel ; c:name "ResultadoAprobacion" ;
    c:uses [ a c:FieldUse ; c:field d:ProjectId ],
           [ a c:FieldUse ; c:field d:Approved ] .
